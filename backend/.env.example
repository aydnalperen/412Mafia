# Copy to .env and load into your shell before running manage.py.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-value
POSTGRES_DB=lecturegraph
POSTGRES_USER=lecturegraph
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# OpenAI Whisper transcription; keep both keys only on the Django server.
OPENAI_API_KEY=
# Optional question/source analysis; recording transcription still uses OpenAI Whisper.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_MEDIA_UPLOAD_MB=50
MAX_MEDIA_DURATION_MINUTES=15
# Conservative estimate for budget checks when provider cost is unavailable; not a billing guarantee.
STT_ESTIMATED_USD_PER_SECOND=0.00005
# Set to a chat model ID available to your OpenRouter account to enable reranking.
OPENROUTER_FAST_MODEL=
OPENROUTER_EXAM_MODEL=
AI_BUDGET_USD=8.00
